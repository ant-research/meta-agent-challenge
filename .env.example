# Copy this file to `.env` next to it and fill in the values you need.
# Each `scripts/*_meta_agent_*.sh` will source this file (when present)
# and abort early if a required variable is missing.

# ---------- Meta-agent (Claude Code) credentials ----------
# Used by every `*_meta_agent.sh` and `*_meta_agent_claude_code.sh` script.
ANTHROPIC_BASE_URL=https://your-anthropic-compatible-endpoint/anthropic
ANTHROPIC_API_KEY=

# ---------- Meta-agent (Codex) credentials ----------
# Used by every `*_meta_agent_codex*.sh` script.
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_API_KEY=

# ---------- Meta-agent (Gemini CLI) credentials ----------
# Used by every `*_meta_agent_gemini*.sh` script. Start the proxy
# (gemini_openai_proxy.py) yourself and point GOOGLE_GEMINI_BASE_URL at it.
GOOGLE_GEMINI_BASE_URL=http://127.0.0.1:8081/
GEMINI_API_KEY=

# ---------- Task model (the model the inner agent uses) ----------
# All scripts read these and pass them into the harness containers.
TASK_MODEL_API_BASE=
TASK_MODEL_API_KEY=
TASK_MODEL_NAME=Qwen/Qwen3-8B

# ---------- Science (GPQA) search API ----------
# Only the science_meta_agent_*.sh scripts need this.
SEARCH_API_BASE=https://api.scrapingdog.com/google
SEARCH_API_KEY=

# ---------- Optional overrides ----------
# MODEL_READMES_DIR defaults to <repo>/model_readmes
# MODEL_README defaults to Qwen3-8B.md
# HARBOR_CLI_SERVICE_PORT defaults to 8899 (swe/tb scripts)
